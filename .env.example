# Core (see src/config.ts). Feature keys are added by each feature.
DATABASE_URL=postgres://gateway:change-me@localhost:5432/gateway
# base64 of 32 random bytes:  openssl rand -base64 32
GATEWAY_ENC_KEY=
# Mail upstream (src/core/upstream): legacy (legacy-proxy -> Gandi) or jmap (native JMAP, e.g. Fastmail)
# UPSTREAM_KIND=legacy
# --- UPSTREAM_KIND=legacy ---
# Must equal legacy-proxy's SESSION_HMAC_KEY
LEGACY_SESSION_HMAC_KEY=
LEGACY_PROXY_URL=http://legacy-proxy:8080
# --- UPSTREAM_KIND=jmap --- (the per-account token is stored by `npm run cli -- bootstrap`)
# UPSTREAM_SESSION_URL=https://api.fastmail.com/jmap/session
# UPSTREAM_AUTH=bearer   # bearer (API token) or basic (password; e.g. a Stalwart test account)
# UPSTREAM_ALLOWED_ORIGINS=https://www.fastmailusercontent.com   # origins besides the session URL's that the session may use
# Public origin of the site (session URLs, links)
PUBLIC_BASE_URL=https://mail.madekivi.fi
# Accounts allowed to sign in (comma-separated). Empty: nobody.
ALLOWED_EMAILS=owner@example.test
# legacy-proxy provider key; slugs are <provider>:<email> (test stacks: stalwart)
# LEGACY_PROVIDER=gandi
# PORT=8080
# HOST=0.0.0.0
# LOG_LEVEL=info
# MIGRATE_ON_START=true
# --- jmap (src/features/jmap/config.ts) ---
# Password mode (Phase 2): accept Basic auth for ALLOWED_EMAILS, verified against legacy-proxy
# JMAP_PASSWORD_MODE=false
# JMAP_BASIC_CACHE_TTL_SEC=300
# JMAP_RL_WINDOW_SEC=900
# JMAP_RL_IP=20
# JMAP_RL_ACCOUNT=5
# JMAP_RL_GLOBAL=30
# JMAP_VERIFY_CONCURRENCY=4
# JMAP_MAX_SIZE_REQUEST=10000000
# JMAP_MAX_SIZE_UPLOAD=50000000
# JMAP_MAX_SIZE_DOWNLOAD=200000000
# JMAP_MAX_CALLS_IN_REQUEST=64
# JMAP_SSE_MAX_AGE_SEC=3600
# JMAP_SSE_MAX_PER_ACCOUNT=10
# JMAP_SSE_MAX_TOTAL=500

# Push (src/features/push/config.ts, design/push.md). Generate keys with:
#   npm run cli -- push:vapid-keys
# Unset keys disable web push (the relay routes answer 503); onNewMail still works.
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:postmaster@madekivi.fi
# Where legacy-proxy reaches /internal/push/jmap/* (test stacks: their own namespace)
# PUSH_INTERNAL_BASE_URL=http://gateway.webmail.svc.cluster.local:8080
# PUSH_ENDPOINT_HOSTS=fcm.googleapis.com,*.push.services.mozilla.com,web.push.apple.com,*.notify.windows.com
# PUSH_RELAY_PENDING_MAX=200          # anonymous registrations awaiting verification, in total
# PUSH_RELAY_PENDING_PER_SOURCE=10    # the same per client address (IPv6: per /64)
# PUSH_UPSTREAM_ALWAYS=false
# PUSH_RECONCILE_INTERVAL_S=300
# PUSH_UPSTREAM_EXPIRES_DAYS=30
# PUSH_MAX_NOTIFY_AGE_S=3600
# PUSH_TTL_S=21600
# PUSH_WORKER_ENABLED=true
# New-mail pushes to Apple's push service as Declarative Web Push (iOS shows them without waking the app,
# and without the service worker's sign-out check: see the README)
# PUSH_APPLE_DECLARATIVE=false
# A per-device preview ticket in every push, for the service worker once its session has expired
# PUSH_PREVIEW_TICKETS=true
# The native iPhone app (APNs). Without the key, devices still register and nothing is sent.
# APNS_URL=https://api.push.apple.com
# APNS_SANDBOX_URL=https://api.sandbox.push.apple.com   (unset with APNS_URL set: APNS_URL takes sandbox tokens too)
# APNS_TOPIC=fi.madekivi.mail                           (comma list of bundle ids devices may register; first = default)
# APNS_PRIVATE_KEY=           (the .p8 content: PKCS#8 PEM, P-256; one line with \n escapes works too; secret)
# APNS_KEY_ID=                (10 characters)
# APNS_TEAM_ID=               (10 characters)
# AI summaries (Phase 5): after the preview push, summarise the newest message with an
# OpenAI-compatible chat-completions endpoint and send a quiet replacement push.
# SUMMARY_ENABLED=false
# The request follows design/summaries prompt v3 (JSON {ai_instructions, summary} via response_format).
# SUMMARY_API_URL=http://llm.example.internal:8092/v1
# SUMMARY_MODEL=webmail-summary
# SUMMARY_API_KEY=            (optional Bearer token; secret)
# SUMMARY_TIMEOUT_MS=120000

# --- auth feature (src/features/auth/config.ts) ---
# Bulwark's OAUTH_CLIENT_SECRET (>= 32 chars). Unset: the bulwark client is disabled.
OAUTH_CLIENT_SECRET_BULWARK=
# AUTH_RP_NAME=Webmail
# AUTH_SESSION_TTL_H=12
