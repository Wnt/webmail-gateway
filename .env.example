# Core (see src/config.ts). Feature keys are added by each feature.
DATABASE_URL=postgres://gateway:change-me@localhost:5432/gateway
# base64 of 32 random bytes:  openssl rand -base64 32
GATEWAY_ENC_KEY=
# Must equal legacy-proxy's SESSION_HMAC_KEY
LEGACY_SESSION_HMAC_KEY=
LEGACY_PROXY_URL=http://legacy-proxy:8080
# Public origin of the site (session URLs, links)
PUBLIC_BASE_URL=https://mail.madekivi.fi
# Accounts allowed to sign in (comma-separated). Empty: nobody.
ALLOWED_EMAILS=jonni@madekivi.fi
# legacy-proxy provider key; slugs are <provider>:<email> (test stacks: stalwart)
# LEGACY_PROVIDER=gandi
# PORT=8080
# HOST=0.0.0.0
# LOG_LEVEL=info
# MIGRATE_ON_START=true
# --- jmap (src/features/jmap/config.ts) ---
# Password mode (Phase 2): accept Basic auth for ALLOWED_EMAILS, verified against legacy-proxy
# JMAP_PASSWORD_MODE=false
# JMAP_BASIC_CACHE_TTL_SEC=300
# JMAP_RL_WINDOW_SEC=900
# JMAP_RL_IP=20
# JMAP_RL_ACCOUNT=5
# JMAP_RL_GLOBAL=30
# JMAP_VERIFY_CONCURRENCY=4
# JMAP_MAX_SIZE_REQUEST=10000000
# JMAP_MAX_SIZE_UPLOAD=50000000
# JMAP_MAX_SIZE_DOWNLOAD=200000000
# JMAP_MAX_CALLS_IN_REQUEST=64
# JMAP_SSE_MAX_AGE_SEC=3600
# JMAP_SSE_MAX_PER_ACCOUNT=10
# JMAP_SSE_MAX_TOTAL=500
