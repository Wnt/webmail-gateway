{
  "name": "webmail-gateway",
  "version": "0.1.0",
  "description": "Gateway in front of legacy-proxy for Bulwark webmail: passkey-only login, OAuth 2.1, push with message previews.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wnt/webmail-gateway.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/cli.js migrate",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "undici": "8.11.2",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
